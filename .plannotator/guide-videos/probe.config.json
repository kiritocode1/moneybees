{
  "$schema": "https://webreel.dev/schema/v1.json",
  "outDir": "./out",
  "baseUrl": "https://moneybees.localhost:1355",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "videos": {
    "probe": {
      "url": "/admin/login",
      "output": "probe.mp4",
      "steps": [
        {
          "action": "wait",
          "selector": "input[name=email]",
          "timeout": 30000
        },
        {
          "action": "pause",
          "ms": 3000
        },
        {
          "action": "click",
          "selector": "input[name=email]"
        },
        {
          "action": "type",
          "text": "$GUIDE_EMAIL",
          "charDelay": 5
        },
        {
          "action": "click",
          "selector": "input[name=password]"
        },
        {
          "action": "type",
          "text": "$GUIDE_PASSWORD",
          "charDelay": 5
        },
        {
          "action": "key",
          "key": "Enter"
        },
        {
          "action": "wait",
          "text": "Today",
          "timeout": 30000
        },
        {
          "action": "navigate",
          "url": "/admin/deals"
        },
        {
          "action": "wait",
          "text": "open PMS",
          "timeout": 30000
        },
        {
          "action": "pause",
          "ms": 800
        },
        {
          "action": "moveTo",
          "selector": "article[data-column]"
        },
        {
          "action": "pause",
          "ms": 800
        },
        {
          "action": "click",
          "text": "List"
        },
        {
          "action": "pause",
          "ms": 1200
        }
      ]
    }
  }
}